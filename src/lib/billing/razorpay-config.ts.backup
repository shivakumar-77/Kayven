import type { PlanId } from './plans'

export type BillingPeriod = 'monthly' | 'yearly'

export interface RazorpayPlanConfig {
  planId: PlanId
  displayName: string
  billingPeriod: BillingPeriod
  mrp: number // in INR
  discountAmount: number // in INR
  offerPrice: number // in INR
  displayDiscountPercentage: number
  currency: 'INR'
  razorpaySubscriptionLink: string
}

// Validate pricing calculations
export function validateRazorpayPlanConfig(config: RazorpayPlanConfig): boolean {
  const calculatedOfferPrice = config.mrp - config.discountAmount
  const calculatedDiscountPercentage = Math.round((config.discountAmount / config.mrp) * 100)

  return config.offerPrice === calculatedOfferPrice &&
         config.displayDiscountPercentage === calculatedDiscountPercentage
}

